# TruthGuard AI Environment Configuration

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://truthguard:truthguard_password@localhost:5432/truthguard

# Hugging Face (Optional, for higher rate limits or private models)
HF_TOKEN=

# Model Checkpoints
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
NLI_MODEL_NAME=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# Verification & Decision Thresholds
VERIFIER_THETA_E=0.70
VERIFIER_THETA_C=0.60
RISK_ALPHA=0.50
RISK_TAU=0.25
RELEVANCE_FLOOR=0.30
TOP_K=5

# Device Configuration (auto, mps, cpu, cuda)
DEVICE=auto

# Storage Paths
CHROMA_PERSIST_DIR=data/processed/chroma
RAW_PDFS_DIR=data/raw_pdfs
PROCESSED_DIR=data/processed
GOLD_DATA_PATH=data/gold/questions.csv
